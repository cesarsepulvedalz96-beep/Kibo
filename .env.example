# Public template only. Run `node scripts/setup-local.mjs` to create `.env`
# with random local passwords. Never commit the generated `.env` file.
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/stockflow
DB_USER=stockflow
DB_PASSWORD=
APP_ALLOWED_ORIGIN=http://localhost:5173
APP_COOKIE_SECURE=false
# Exact trusted proxy IPs, comma-separated; empty for direct local development.
# Compose sets this itself for its dedicated Nginx network.
APP_TRUSTED_PROXIES=
BOOTSTRAP_ADMIN_EMAIL=admin@kivo.local
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_USER_EMAIL=demo@kivo.local
DEMO_USER_PASSWORD=
# Only public configuration may start with VITE_.
VITE_API_URL=/api/v1
AWS_REGION=us-east-1
S3_BUCKET=
